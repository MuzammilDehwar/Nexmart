{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "vendor", "admin"],
          "description": "User role strictly governed by platform RBAC"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user registration"
        }
      },
      "required": ["id", "email", "role"]
    },
    "VendorApplication": {
      "title": "VendorApplication",
      "description": "Artisan/seller application awaiting admin review",
      "type": "object",
      "properties": {
        "applicantUid": {
          "type": "string",
          "description": "UID of the applicant"
        },
        "applicantEmail": {
          "type": "string",
          "format": "email",
          "description": "Contact email of applicant"
        },
        "applicantName": {
          "type": "string",
          "description": "Applicant full name"
        },
        "storeName": {
          "type": "string",
          "description": "Requested store name",
          "maxLength": 100
        },
        "storeSlug": {
          "type": "string",
          "description": "URL-safe slug for the merchant storefront"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation status"
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of application submission"
        }
      },
      "required": ["applicantUid", "applicantEmail", "storeName", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Multi-vendor catalog product record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product ID"
        },
        "title": {
          "type": "string",
          "description": "Product display title",
          "maxLength": 200
        },
        "slug": {
          "type": "string",
          "description": "URL slug for product detail view"
        },
        "brand": {
          "type": "string",
          "description": "Brand or maker name"
        },
        "storeName": {
          "type": "string",
          "description": "Merchant business name"
        },
        "storeSlug": {
          "type": "string",
          "description": "Merchant URL identifier"
        },
        "basePrice": {
          "type": "number",
          "description": "Base price in USD"
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Platform moderation status"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Optional admin feedback if rejected"
        },
        "vendorUid": {
          "type": "string",
          "description": "UID of the owning vendor"
        }
      },
      "required": ["id", "title", "storeSlug", "basePrice", "approvalStatus"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction spanning multi-vendor packages",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order identifier"
        },
        "customerId": {
          "type": "string",
          "description": "UID of purchasing customer"
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Customer email"
        },
        "customerName": {
          "type": "string",
          "description": "Recipient full name"
        },
        "total": {
          "type": "number",
          "description": "Total charged amount in USD"
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal before tax and shipping"
        },
        "overallStatus": {
          "type": "string",
          "enum": ["Ordered", "Packed", "Shipped", "Delivered"],
          "description": "Consolidated fulfillment status"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["stripe", "cod", "bnpl"],
          "description": "Selected payment gateway"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid", "refunded", "failed"],
          "description": "Server-reconciled payment status"
        }
      },
      "required": ["id", "customerId", "customerEmail", "total", "overallStatus"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Private user profile documents"
    },
    "/vendor_applications/{appId}": {
      "schema": { "$ref": "VendorApplication" },
      "description": "Prospective merchant seller applications"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Catalog products for public storefront and vendor management"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Multi-vendor customer orders"
    }
  }
}
